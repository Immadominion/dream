<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 (API 30) and below: legacy auto-backup config.
  allowBackup is set to false in the manifest, so no data is backed up. These
  exclusions are defense-in-depth in case backup is ever re-enabled, ensuring
  auth tokens and credentials are never copied to cloud backups.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
